# Classroom Runtime 本地/容器运行参数
# 注意：reference Server 尚未接入正式 credential/membership 认证。源码默认仅监听 127.0.0.1；
# reference 开发环境始终保持 loopback；LAN 发布只允许通过 authenticated D7 Compose，并且必须先通过 d7:product。
HOST=127.0.0.1
PORT=8787

# 本机直接运行默认 127.0.0.1；Docker 内需设 0.0.0.0，再由 Docker 绑定宿主 127.0.0.1。
LOCAL_TOOLS_HOST=127.0.0.1
LOCAL_TOOLS_PORT=8788

CLASSROOM_DATA_DIR=.runtime-data
MAX_WS_MESSAGE_BYTES=262144
OBSERVER_MAX_BUFFER_BYTES=524288
