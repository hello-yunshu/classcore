{
  "config:restore-board": {
    "configRef": "config:restore-board",
    "appletTypeId": "applet:transform-board",
    "configSchemaVersion": 1,
    "payload": {
      "targetAssetId": "asset:target",
      "board": { "columns": 16, "rows": 8, "coordinateUnit": "grid-cell" },
      "allowedRotationDegrees": [90, 180, 270],
      "objects": [
        { "objectId": "piece:a", "label": "A", "shape": "triangle", "visual": { "color": "#897E70", "clipPath": "polygon(50% 0%, 100% 100%, 0% 100%)" }, "x": 2, "y": 1, "width": 2, "height": 2, "rotation": 0, "pivots": { "vertex-a": { "x": 0, "y": 0 }, "center": { "x": 0.5, "y": 0.5 } }, "initialPivotId": "vertex-a", "targetTransform": { "x": 6, "y": 2, "rotation": 90 } },
        { "objectId": "piece:b", "label": "B", "shape": "quadrilateral", "visual": { "color": "#5575B8", "clipPath": "none" }, "x": 5, "y": 4, "width": 2, "height": 2, "rotation": 0, "pivots": { "vertex-b": { "x": 1, "y": 0 }, "center": { "x": 0.5, "y": 0.5 } }, "initialPivotId": "vertex-b", "targetTransform": { "x": 8, "y": 2, "rotation": 180 } },
        { "objectId": "piece:c", "label": "C", "shape": "arch", "visual": { "color": "#C96B55", "clipPath": "polygon(0% 100%, 0% 38%, 18% 12%, 50% 0%, 82% 12%, 100% 38%, 100% 100%, 70% 100%, 70% 50%, 50% 34%, 30% 50%, 30% 100%)" }, "x": 9, "y": 1, "width": 2, "height": 2, "rotation": 0, "pivots": { "vertex-c": { "x": 0, "y": 1 }, "center": { "x": 0.5, "y": 0.5 } }, "initialPivotId": "vertex-c", "targetTransform": { "x": 10, "y": 4, "rotation": 270 } },
        { "objectId": "piece:d", "label": "D", "shape": "quarter-circle", "visual": { "color": "#7A9A73", "clipPath": "polygon(0% 0%, 100% 0%, 100% 100%, 78% 100%, 60% 96%, 44% 88%, 30% 76%, 18% 60%, 8% 42%, 0% 20%)" }, "x": 12, "y": 4, "width": 2, "height": 2, "rotation": 0, "pivots": { "vertex-d": { "x": 1, "y": 1 }, "center": { "x": 0.5, "y": 0.5 } }, "initialPivotId": "vertex-d", "targetTransform": { "x": 5, "y": 4, "rotation": 90 } }
      ],
      "rules": {
        "rotationCenterPolicy": "lesson-configured-vertex",
        "recordVocabularyRef": "analytics/path-record-vocabulary",
        "recordVocabulary": {
          "label": "记录路径：",
          "figurePrefix": "图形",
          "vertexPrefix": "顶点",
          "tokens": [
            { "kind": "word", "value": "向", "display": "向" },
            { "kind": "word", "value": "平移", "display": "平移" },
            { "kind": "direction", "value": "right", "display": "右" },
            { "kind": "unit", "value": "格", "display": "格" },
            { "kind": "word", "value": "绕点", "display": "绕点" },
            { "kind": "word", "value": "旋转", "display": "旋转" },
            { "kind": "rotation", "value": "clockwise", "display": "顺时针" },
            { "kind": "unit", "value": "度", "display": "度" },
            { "kind": "digit", "value": "90", "display": "90" },
            { "kind": "separator", "value": "，", "display": "，" }
          ]
        }
      }
    }
  },
  "config:instruction-builder": {
    "configRef": "config:instruction-builder",
    "appletTypeId": "applet:structured-instruction-builder",
    "configSchemaVersion": 1,
    "payload": {
      "vocabularyRef": "analytics/path-record-vocabulary",
      "allowedBlockTypes": ["translate", "rotate", "anchor", "separator"]
    }
  },
  "config:peer-board": {
    "configRef": "config:peer-board",
    "appletTypeId": "applet:transform-board",
    "configSchemaVersion": 1,
    "payload": {
      "targetAssetId": "asset:target",
      "boardConfigRef": "config:restore-board",
      "mode": "peer-execution"
    }
  }
}
