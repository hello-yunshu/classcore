{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"SurfaceProjectionContracts",
  "$defs":{
    "publicStudentProjection":{
      "type":"object","required":["subjectId","label"],"properties":{
        "subjectId":{"type":"string","pattern":"^anon:[0-9]+$"},
        "label":{"type":"string","minLength":1}
      },"additionalProperties":false
    },
    "teacherStudentProjection":{
      "type":"object","required":["participantId","displayName"],"properties":{
        "participantId":{"type":"string","pattern":"^student:"},
        "displayName":{"type":"string","minLength":1},
        "seatNo":{"type":["string","null"]},
        "classId":{"type":["string","null"]}
      },"additionalProperties":false
    },
    "studentSelfProjection":{
      "type":"object","required":["participantId","displayName"],"properties":{
        "participantId":{"type":"string","pattern":"^student:"},
        "displayName":{"type":"string","minLength":1},
        "seatNo":{"type":["string","null"]}
      },"additionalProperties":false
    },
    "backstageStudentProjection":{
      "type":"object","required":["participantId","displayName"],"properties":{
        "participantId":{"type":"string","pattern":"^student:"},
        "displayName":{"type":"string","minLength":1},
        "seatNo":{"type":["string","null"]},
        "classId":{"type":["string","null"]},
        "rosterId":{"type":["string","null"]}
      },"additionalProperties":false
    },
    "projectedStageState":{
      "type":"object","required":["sessionId","revision","contentType","audience","payload"],"properties":{
        "sessionId":{"type":"string","minLength":1},
        "revision":{"type":"integer","minimum":0},
        "contentType":{"type":"string","pattern":"^[a-z][a-z0-9-]*:[a-z][a-z0-9-]*$"},
        "audience":{"enum":["teacher-runtime","observer","display"]},
        "payload":{"type":"object"}
      },"additionalProperties":false
    }
  }
}
