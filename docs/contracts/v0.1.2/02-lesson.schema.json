{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LessonDefinition",
  "type": "object",
  "required": [
    "lessonSchemaVersion",
    "lessonId",
    "version",
    "title",
    "activities",
    "assets"
  ],
  "properties": {
    "lessonSchemaVersion": {
      "const": 1
    },
    "lessonId": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "activities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "assetId",
          "path",
          "mimeType",
          "preload"
        ],
        "properties": {
          "assetId": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "mimeType": {
            "type": "string",
            "minLength": 1
          },
          "size": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          },
          "preload": {
            "type": "boolean"
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "preload": {
                  "const": true
                }
              },
              "required": [
                "preload"
              ]
            },
            "then": {
              "required": [
                "size",
                "sha256"
              ],
              "properties": {
                "size": {
                  "type": "integer",
                  "minimum": 0
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          }
        ]
      }
    },
    "metadata": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
