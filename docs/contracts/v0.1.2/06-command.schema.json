      "type": [
        "string",
        "null"
      ]
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": [
        "object",
        "null"
      ]
    },
    "payload": {
      "type": "object"
    },
    "expectedRevision": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    }
  },
  "additionalProperties": false
}
