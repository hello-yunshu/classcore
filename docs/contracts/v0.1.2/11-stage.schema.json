{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClassroomStageState",
  "type": "object",
  "required": [
    "sessionId",
    "revision",
    "contentType",
    "payload"
  ],
  "properties": {
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "contentType": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9-]*$"
    },
    "payload": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
