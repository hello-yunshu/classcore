{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IntelligenceContracts",
  "$defs": {
    "diagnosis": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "DiagnosisRecord",
      "type": "object",
      "required": [
        "diagnosisId",
        "schemaVersion",
        "sessionId",
        "activityId",
        "studentId",
        "code",
        "confidence",
        "evidence",
        "provider",
        "createdAt"
      ],
      "properties": {
        "diagnosisId": {
          "type": "string",
          "minLength": 1
        },
        "schemaVersion": {
          "const": 1
        },
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "activityId": {
          "type": "string",
          "minLength": 1
        },
        "studentId": {
          "type": "string",
          "minLength": 1
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "provider": {
          "type": "object",
          "required": [
            "mode",
            "name",
            "version"
          ],
          "properties": {
            "mode": {
              "enum": [
                "rule",
                "llm",
                "hybrid"
              ]
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": [
                "string",
                "null"
              ]
            },
            "promptVersion": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "createdAt": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "intervention": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "InterventionDecision",
      "type": "object",
      "required": [
        "interventionId",
        "schemaVersion",
        "diagnosisId",
        "needed",
        "level",
        "provider",
        "createdAt"
      ],
      "properties": {
        "interventionId": {
          "type": "string",
          "minLength": 1
        },
        "schemaVersion": {
          "const": 1
        },
        "diagnosisId": {
          "type": "string",
          "minLength": 1
        },
        "needed": {
          "type": "boolean"
        },
        "level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "provider": {
          "type": "object",
          "required": [
            "mode",
            "name",
            "version"
          ],
          "properties": {
            "mode": {
              "enum": [
                "rule",
                "llm",
                "hybrid"
              ]
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": [
                "string",
                "null"
              ]
            },
            "promptVersion": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "createdAt": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "advice": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "AdviceRecord",
      "type": "object",
      "required": [
        "adviceId",
        "schemaVersion",
        "diagnosisId",
        "interventionId",
        "studentId",
        "status",
        "provider",
        "createdAt"
      ],
      "properties": {
        "adviceId": {
          "type": "string",
          "minLength": 1
        },
        "schemaVersion": {
          "const": 1
        },
        "diagnosisId": {
          "type": "string",
          "minLength": 1
        },
        "interventionId": {
          "type": "string",
          "minLength": 1
        },
        "studentId": {
          "type": "string",
          "minLength": 1
        },
        "views": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "student": {
              "type": [
                "string",
                "null"
              ]
            },
            "teacher": {
              "type": [
                "string",
                "null"
              ]
            },
            "observer": {
              "type": [
                "string",
                "null"
              ]
            },
            "templateFamily": {
              "type": [
                "string",
                "null"
              ]
            },
            "variantId": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "status": {
          "enum": [
            "observing",
            "triggered",
            "shown",
            "waiting",
            "resolved",
            "escalated",
            "expired"
          ]
        },
        "provider": {
          "type": "object",
          "required": [
            "mode",
            "name",
            "version"
          ],
          "properties": {
            "mode": {
              "enum": [
                "rule",
                "llm",
                "hybrid"
              ]
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": [
                "string",
                "null"
              ]
            },
            "promptVersion": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "createdAt": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
